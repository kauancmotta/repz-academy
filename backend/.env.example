# Servidor
PORT=3001
FRONTEND_URL=http://localhost:8080

# Banco de dados (valores iguais aos padrões do docker-compose.yml)
DATABASE_URL="postgresql://repz:repz@localhost:5432/repz?schema=public"

# Autenticação (usado a partir da funcionalidade 001). Troque o segredo fora do desenvolvimento.
JWT_SECRET=troque-este-segredo-em-desenvolvimento
JWT_EXPIRES_IN=7d
