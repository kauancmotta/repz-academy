// Schema do Prisma do Repz.
// Os modelos são adicionados por funcionalidade (001: User, 002: Invite, 003: Exercise, 004: Workout, 005: WorkoutSession/SetLog, ...).
// A URL do banco é lida de prisma.config.ts (variável DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSONAL
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Preenchido somente para alunos (RN-03): o vínculo pertence ao aluno.
  personalId   String?
  personal     User?    @relation("PersonalStudents", fields: [personalId], references: [id])
  students     User[]   @relation("PersonalStudents")
  createdAt    DateTime @default(now())

  // Convites gerados pelo personal e convites resgatados pelo aluno (002).
  invitesCreated Invite[] @relation("PersonalInvites")
  invitesUsed    Invite[] @relation("StudentInvites")

  // Exercícios criados pelo usuário (003).
  exercises Exercise[]

  // Treinos: como aluno (destinatário) e como autor (004).
  workoutsAsStudent Workout[] @relation("StudentWorkouts")
  workoutsAuthored  Workout[] @relation("AuthoredWorkouts")

  // Sessões de treino executadas pelo aluno (005).
  sessions WorkoutSession[]

  @@index([personalId])
}

// Convite de vínculo (RN-04): código de uso único que expira em 7 dias.
// O status (ACTIVE, USED, EXPIRED) é calculado a partir de usedAt e expiresAt.
model Invite {
  id              String    @id @default(uuid())
  code            String    @unique
  personalId      String
  personal        User      @relation("PersonalInvites", fields: [personalId], references: [id])
  expiresAt       DateTime
  usedAt          DateTime?
  usedByStudentId String?
  usedByStudent   User?     @relation("StudentInvites", fields: [usedByStudentId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([personalId])
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  CARDIO
  OTHER
}

// Exercício do catálogo (RN-11, RN-12). createdById nulo = exercício global (seed).
// Quando treinos e sessões passarem a referenciar o exercício (004 e 005), a chave estrangeira
// sem onDelete impede a remoção de um exercício em uso (o serviço converte o erro em 409).
model Exercise {
  id          String      @id @default(uuid())
  name        String
  muscleGroup MuscleGroup
  description String?
  // Link original informado pelo usuário; a URL de embed é calculada na resposta.
  videoUrl    String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // Itens de treino que usam este exercício (004). A chave estrangeira restrita impede remover exercício em uso.
  workoutItems WorkoutItem[]

  // Séries realizadas deste exercício (005). Também impede remover exercício com histórico.
  setLogs SetLog[]

  // O PostgreSQL trata NULL como diferente, então a unicidade dos globais é garantida pelo seed.
  @@unique([name, createdById])
  @@index([createdById])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Treino de um aluno (RN-07 a RN-10). O autor é o personal ou o próprio aluno (sem personal).
// archivedAt só registra o arquivamento manual; o "arquivado por regra" (treino próprio de aluno
// com personal) é calculado no serviço e nunca gravado (ver docs/arquitetura.md, seção 5).
model Workout {
  id         String        @id @default(uuid())
  name       String
  studentId  String
  student    User          @relation("StudentWorkouts", fields: [studentId], references: [id])
  authorId   String
  author     User          @relation("AuthoredWorkouts", fields: [authorId], references: [id])
  archivedAt DateTime?
  items      WorkoutItem[]
  // Sem onDelete: treino com sessões não pode ser removido (409 WORKOUT_HAS_SESSIONS).
  sessions   WorkoutSession[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([studentId])
  @@index([authorId])
}

// Item de treino: um exercício em um dia da semana (RN-10).
model WorkoutItem {
  id          String   @id @default(uuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  weekday     Weekday
  order       Int
  sets        Int
  targetReps  Int
  restSeconds Int?
  notes       String?

  @@unique([workoutId, weekday, order])
  @@index([exerciseId])
}

// Execução de um treino em um dia da semana (RN-13). Em andamento enquanto finishedAt é nulo;
// cada aluno tem no máximo uma sessão em andamento (garantido no serviço).
model WorkoutSession {
  id         String    @id @default(uuid())
  studentId  String
  student    User      @relation(fields: [studentId], references: [id])
  workoutId  String
  workout    Workout   @relation(fields: [workoutId], references: [id])
  weekday    Weekday
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  sets       SetLog[]

  @@index([studentId, finishedAt])
  @@index([workoutId])
}

// Série realizada. exerciseId fica direto na série para a evolução independer de edições no treino.
// workoutItemId não tem chave estrangeira: editar o treino troca os ids dos itens e o histórico deve permanecer.
model SetLog {
  id            String         @id @default(uuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutItemId String?
  exerciseId    String
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber     Int
  weightKg      Decimal        @db.Decimal(6, 2)
  reps          Int
  completedAt   DateTime       @default(now())

  @@unique([sessionId, workoutItemId, setNumber])
  @@index([exerciseId])
}
