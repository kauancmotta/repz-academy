// Schema do Prisma do Repz.
// Os modelos são adicionados por funcionalidade (001: User, 002: Invite, ...).
// A URL do banco é lida de prisma.config.ts (variável DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSONAL
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Preenchido somente para alunos (RN-03): o vínculo pertence ao aluno.
  personalId   String?
  personal     User?    @relation("PersonalStudents", fields: [personalId], references: [id])
  students     User[]   @relation("PersonalStudents")
  createdAt    DateTime @default(now())
}
