// Schema do Prisma do Repz.
// Os modelos são adicionados por funcionalidade (001: User, 002: Invite, 003: Exercise, ...).
// A URL do banco é lida de prisma.config.ts (variável DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PERSONAL
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Preenchido somente para alunos (RN-03): o vínculo pertence ao aluno.
  personalId   String?
  personal     User?    @relation("PersonalStudents", fields: [personalId], references: [id])
  students     User[]   @relation("PersonalStudents")
  createdAt    DateTime @default(now())

  // Convites gerados pelo personal e convites resgatados pelo aluno (002).
  invitesCreated Invite[] @relation("PersonalInvites")
  invitesUsed    Invite[] @relation("StudentInvites")

  // Exercícios criados pelo usuário (003).
  exercises Exercise[]

  @@index([personalId])
}

// Convite de vínculo (RN-04): código de uso único que expira em 7 dias.
// O status (ACTIVE, USED, EXPIRED) é calculado a partir de usedAt e expiresAt.
model Invite {
  id              String    @id @default(uuid())
  code            String    @unique
  personalId      String
  personal        User      @relation("PersonalInvites", fields: [personalId], references: [id])
  expiresAt       DateTime
  usedAt          DateTime?
  usedByStudentId String?
  usedByStudent   User?     @relation("StudentInvites", fields: [usedByStudentId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([personalId])
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  CARDIO
  OTHER
}

// Exercício do catálogo (RN-11, RN-12). createdById nulo = exercício global (seed).
// Quando treinos e sessões passarem a referenciar o exercício (004 e 005), a chave estrangeira
// sem onDelete impede a remoção de um exercício em uso (o serviço converte o erro em 409).
model Exercise {
  id          String      @id @default(uuid())
  name        String
  muscleGroup MuscleGroup
  description String?
  // Link original informado pelo usuário; a URL de embed é calculada na resposta.
  videoUrl    String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // O PostgreSQL trata NULL como diferente, então a unicidade dos globais é garantida pelo seed.
  @@unique([name, createdById])
  @@index([createdById])
}
